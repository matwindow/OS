___
Close:{
  enabled:true,
  show:true,
  onclick:()=>{}
},
Maximalize:{
  enabled:true,
  show:true,
  onclick:()=>{}
},
Minimalize:{
  enabled:true,
  show:true,
  onclick:()=>{}
},
OnOpen:(win)=>{
  const input = win.querySelector('input');
  if (input) setTimeout(() => input.focus(), 100);
},
Style:{
  blur:"80%",
  title:"MatGPT",
  titlebar:{
    color:"rgba(12,14,20,0.54)"
  },
  maincolor:"rgba(30,32,45,0.32)"
},
render:(root)=>{
  const shell = document.createElement('div');
  shell.style.cssText = 'width:100%;height:100%;display:flex;flex-direction:column;gap:12px;padding:16px;box-sizing:border-box;color:#edf5ff;font-family:Tahoma, Geneva, sans-serif;';

  const topbar = document.createElement('div');
  topbar.style.cssText = 'display:flex;align-items:center;justify-content:space-between;gap:12px;';

  const title = document.createElement('div');
  title.textContent = 'MatGPT';
  title.style.cssText = 'font-size:18px;font-weight:700;letter-spacing:0.05em;color:#f4f7ff;text-shadow:0 0 18px rgba(110,150,255,0.45);';

  const status = document.createElement('div');
  status.textContent = 'online';
  status.style.cssText = 'padding:4px 8px;border-radius:999px;background:rgba(48,223,125,0.12);border:1px solid rgba(48,223,125,0.35);color:#9ff8b8;font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;';

  topbar.appendChild(title);
  topbar.appendChild(status);

  const chat = document.createElement('div');
  chat.style.cssText = 'flex:1;display:flex;flex-direction:column;gap:10px;overflow:auto;padding:10px;border-radius:12px;border:1px solid rgba(255,255,255,0.04);background:rgba(255,255,255,0.02);';

  const form = document.createElement('form');
  form.style.cssText = 'display:flex;gap:10px;';

  const input = document.createElement('input');
  input.type = 'text';
  input.placeholder = 'Ask MatGPT...';
  input.autocomplete = 'off';
  input.style.cssText = 'flex:1;height:46px;padding:0 14px;border-radius:12px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);color:#fff;font-size:15px;outline:none;';

  const send = document.createElement('button');
  send.type = 'submit';
  send.textContent = 'Send';
  send.style.cssText = 'height:46px;padding:0 18px;border:none;border-radius:12px;background:linear-gradient(90deg, rgba(78,115,255,0.92), rgba(38,216,255,0.88));color:#02120d;font-weight:800;cursor:pointer;';

  function makeBubble(role, text) {
    const wrapper = document.createElement('div');
    wrapper.style.cssText = 'display:flex;flex-direction:column;gap:4px;';

    const label = document.createElement('div');
    label.textContent = role === 'user' ? 'You' : 'MatGPT';
    label.style.cssText = role === 'user'
      ? 'font-size:11px;font-weight:700;color:#a7c8ff;letter-spacing:0.08em;text-transform:uppercase;'
      : 'font-size:11px;font-weight:700;color:#9df5d4;letter-spacing:0.08em;text-transform:uppercase;';

    const bubble = document.createElement('div');
    bubble.style.cssText = role === 'user'
      ? 'padding:10px 12px;border-radius:12px;background:rgba(107,136,255,0.12);border:1px solid rgba(142,168,255,0.18);color:#edf3ff;white-space:pre-wrap;'
      : 'padding:10px 12px;border-radius:12px;background:rgba(26,214,170,0.07);border:1px solid rgba(70,238,188,0.18);color:#ecfffb;white-space:pre-wrap;';
    bubble.textContent = text;

    wrapper.appendChild(label);
    wrapper.appendChild(bubble);
    return wrapper;
  }

  function addMessage(role, text) {
    const node = makeBubble(role, text);
    chat.appendChild(node);
    chat.scrollTop = chat.scrollHeight;
  }

  function loadLocalHistory() {
    try {
      const raw = localStorage.getItem('matgpt_history_v1');
      if (!raw) return;
      const items = JSON.parse(raw);
      if (!Array.isArray(items)) return;
      for (const item of items) {
        if (!item || !item.text) continue;
        addMessage(item.role === 'assistant' ? 'assistant' : 'user', item.text);
      }
    } catch (e) {
      console.warn('Failed to load MatGPT history', e);
    }
  }

  function saveLocalHistory(role, text) {
    try {
      const list = JSON.parse(localStorage.getItem('matgpt_history_v1') || '[]');
      if (!Array.isArray(list)) return;
      list.push({ role, text, ts: Date.now() });
      localStorage.setItem('matgpt_history_v1', JSON.stringify(list));
    } catch (e) {
      console.warn('Failed to save MatGPT history', e);
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const prompt = input.value.trim();
    if (!prompt) return;

    addMessage('user', prompt);
    saveLocalHistory('user', prompt);
    input.value = '';

    setTimeout(() => {
      const helper = window.matgpt && typeof window.matgpt.answer === 'function' ? window.matgpt : null;
      const response = helper ? helper.answer(prompt) : 'MatGPT helper is unavailable in this session.';
      addMessage('assistant', response);
      saveLocalHistory('assistant', response);
    }, 220);
  });

  const intro = document.createElement('div');
  intro.style.cssText = 'padding:10px 12px;border-radius:12px;background:rgba(255,255,255,0.025);border:1px solid rgba(255,255,255,0.04);color:#dbeaff;';
  intro.textContent = 'I am MatGPT — ask me for time, date, math, text transforms, or app actions.';
  chat.appendChild(intro);

  loadLocalHistory();

  form.appendChild(input);
  form.appendChild(send);
  shell.appendChild(topbar);
  shell.appendChild(chat);
  shell.appendChild(form);
  root.appendChild(shell);
}
___
