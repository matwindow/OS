___
Close:{
  enabled:true,
  show:true,
  onclick:()=>{}
},
Maximalize:{
  enabled:true,
  show:true,
  onclick:()=>{}
},
Minimalize:{
  enabled:true,
  show:true,
  onclick:()=>{}
},
OnOpen:(win)=>{
  const input = win.querySelector('input');
  if (input) setTimeout(() => input.focus(), 120);
},
Style:{
  blur:"80%",
  title:"MatGPT",
  titlebar:{
    color:"rgba(12,14,20,0.54)"
  },
  maincolor:"rgba(30,32,45,0.32)"
},
render:(root)=>{
  // ensure root fills and acts as flex column so chat can scroll
  try{
    root.style.display = 'flex';
    root.style.flexDirection = 'column';
    root.style.height = '100%';
    root.style.boxSizing = 'border-box';
  }catch(e){}

  // helper to load an image with fallback
  function loadIcon(path, fallback){
    const img = document.createElement('img');
    img.src = path;
    img.onerror = () => { img.src = fallback; };
    img.style.width = '20px'; img.style.height = '20px'; img.style.objectFit = 'contain';
    return img;
  }

  const shell = document.createElement('div');
  shell.style.cssText = 'width:100%;display:flex;flex-direction:column;gap:12px;padding:12px;box-sizing:border-box;flex:1;min-height:0;color:#edf5ff;font-family:Tahoma, Geneva, sans-serif;';

  const topbar = document.createElement('div');
  topbar.style.cssText = 'display:flex;align-items:center;justify-content:space-between;gap:12px;';

  const title = document.createElement('div');
  title.textContent = 'MatGPT';
  title.style.cssText = 'font-size:18px;font-weight:700;letter-spacing:0.05em;color:#f4f7ff;text-shadow:0 0 18px rgba(110,150,255,0.45);';

  const controls = document.createElement('div');
  controls.style.cssText = 'display:flex;align-items:center;gap:8px;';

  // paths for user icons with fallback
  const fallback = 'png/icon.png';
  const icNew = loadIcon('png/chatbot/newchat.png', fallback);
  const icChats = loadIcon('png/chatbot/chats.png', fallback);
  const icSend = loadIcon('png/chatbot/send.png', fallback);
  const icStop = loadIcon('png/chatbot/stoprepond.png', fallback);
  const icCopilot = loadIcon('png/chatbot/copilot.png', fallback);

  const btnNew = document.createElement('button');
  btnNew.title='New Chat';
  btnNew.style.cssText='background:transparent;border:none;cursor:pointer;padding:6px;border-radius:8px;';
  btnNew.appendChild(icNew);

  const btnChats = document.createElement('button');
  btnChats.title='API Key';
  btnChats.style.cssText='background:transparent;border:none;cursor:pointer;padding:6px;border-radius:8px;';
  btnChats.appendChild(icChats);

  const btnStop = document.createElement('button');
  btnStop.title='Stop';
  btnStop.style.cssText='background:transparent;border:none;cursor:pointer;padding:6px;border-radius:8px;';
  btnStop.appendChild(icStop);

  const btnCopilot = document.createElement('button');
  btnCopilot.title = 'Use Copilot Bridge';
  btnCopilot.style.cssText = 'background:transparent;border:none;cursor:pointer;padding:6px;border-radius:8px;opacity:0.7;';
  btnCopilot.appendChild(icCopilot);

  controls.appendChild(btnNew); controls.appendChild(btnChats); controls.appendChild(btnStop); controls.appendChild(btnCopilot);

  topbar.appendChild(title);
  topbar.appendChild(controls);

  const status = document.createElement('div');
  status.textContent = 'online';
  status.style.cssText = 'padding:4px 8px;border-radius:999px;background:rgba(48,223,125,0.12);border:1px solid rgba(48,223,125,0.35);color:#9ff8b8;font-size:11px;font-weight:700;letter-spacing:0.06em;';

  topbar.appendChild(status);

  const chat = document.createElement('div');
  chat.style.cssText = 'flex:1;min-height:0;display:flex;flex-direction:column;gap:10px;overflow-y:auto;padding:12px;border-radius:12px;border:1px solid rgba(255,255,255,0.04);background:linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.00));';

  // message creation
  function makeBubble(role, text){
    const wrapper = document.createElement('div');
    wrapper.style.cssText = 'display:flex;flex-direction:column;gap:6px;';
    wrapper.dataset.role = role === 'assistant' ? 'assistant' : 'user';

    const label = document.createElement('div');
    label.textContent = role === 'user' ? 'You' : 'MatGPT';
    label.style.cssText = role === 'user' ? 'font-size:11px;font-weight:700;color:#a7c8ff;letter-spacing:0.08em;text-transform:uppercase;' : 'font-size:11px;font-weight:700;color:#9df5d4;letter-spacing:0.08em;text-transform:uppercase;';

    const bubble = document.createElement('div');
    bubble.style.cssText = role === 'user' ? 'padding:10px 12px;border-radius:10px;background:rgba(107,136,255,0.06);border:1px solid rgba(142,168,255,0.08);color:#edf3ff;white-space:pre-wrap;max-width:85%;' : 'padding:10px 12px;border-radius:10px;background:linear-gradient(180deg, rgba(25,28,40,0.6), rgba(20,22,34,0.6));border:1px solid rgba(255,255,255,0.02);color:#e9fff4;white-space:pre-wrap;max-width:85%;';
    bubble.textContent = text;

    wrapper.appendChild(label);
    wrapper.appendChild(bubble);
    return wrapper;
  }

  function addMessage(role, text){
    const node = makeBubble(role, text);
    chat.appendChild(node);
    requestAnimationFrame(()=>{ chat.scrollTop = chat.scrollHeight; });
  }

  function loadLocalHistory(){
    try{
      const raw = localStorage.getItem('matgpt_history_v1');
      if (!raw) return [];
      const items = JSON.parse(raw);
      if (!Array.isArray(items)) return [];
      for (const item of items){ if (!item || !item.text) continue; addMessage(item.role === 'assistant' ? 'assistant' : 'user', item.text); }
      return items;
    }catch(e){ console.warn('Failed to load MatGPT history', e); return []; }
  }

  function saveLocalHistory(role, text){
    try{
      const list = JSON.parse(localStorage.getItem('matgpt_history_v1') || '[]');
      if (!Array.isArray(list)) return;
      list.push({ role, text, ts: Date.now() });
      localStorage.setItem('matgpt_history_v1', JSON.stringify(list));
    }catch(e){ console.warn('Failed to save MatGPT history', e); }
  }

  function clearLocalHistory(){ try{ localStorage.removeItem('matgpt_history_v1'); chat.innerHTML = ''; addIntro(); }catch(e){} }

  const form = document.createElement('form'); form.style.cssText = 'display:flex;gap:8px;align-items:center;';
  const input = document.createElement('input'); input.type='text'; input.placeholder='Ask MatGPT...'; input.autocomplete='off';
  input.style.cssText='flex:1;height:44px;padding:0 12px;border-radius:12px;border:1px solid rgba(255,255,255,0.06);background:rgba(255,255,255,0.02);color:#fff;font-size:14px;outline:none;';

  const sendBtn = document.createElement('button'); sendBtn.type='submit'; sendBtn.title='Send'; sendBtn.style.cssText='height:44px;padding:0 12px;border:none;border-radius:12px;background:linear-gradient(180deg, rgba(90,120,255,1), rgba(70,100,235,1));cursor:pointer;display:flex;align-items:center;justify-content:center;';
  const sendImg = loadIcon('png/chatbot/send.png', 'png/icon.png'); sendImg.style.width='18px'; sendImg.style.height='18px'; sendBtn.appendChild(sendImg);

  form.appendChild(input); form.appendChild(sendBtn);

  function setCopilotActive(active){
    try{
      if (active) {
        localStorage.setItem('matgpt_use_copilot', '1');
        btnCopilot.style.opacity = '1';
        status.textContent = 'Copilot';
        status.style.background = 'rgba(110,150,255,0.08)';
        status.style.border = '1px solid rgba(110,150,255,0.18)';
        status.style.color = '#cfe4ff';
      } else {
        localStorage.removeItem('matgpt_use_copilot');
        btnCopilot.style.opacity = '0.7';
        status.textContent = 'online';
        status.style.background = 'rgba(48,223,125,0.12)';
        status.style.border = '1px solid rgba(48,223,125,0.35)';
        status.style.color = '#9ff8b8';
      }
    }catch(e){}
  }

  (function(){
    const v = localStorage.getItem('matgpt_use_copilot') === '1';
    setCopilotActive(v);
  })();

  form.addEventListener('submit', async (e)=>{
    e.preventDefault();
    const prompt = input.value.trim();
    if(!prompt) return;
    addMessage('user', prompt);
    saveLocalHistory('user', prompt);
    input.value='';

    const thinkingNode = makeBubble('assistant', 'MatGPT is thinking...');
    chat.appendChild(thinkingNode);
    requestAnimationFrame(()=>{ chat.scrollTop = chat.scrollHeight; });

    try {
      // Prefer saved API key if present (the normal OpenAI path)
      const key = window.matgpt && typeof window.matgpt.getApiKey === 'function' ? window.matgpt.getApiKey() : '';
      if (key) {
        const response = await window.matgpt.remoteAnswer(prompt, { model: 'gpt-3.5-turbo' });
        thinkingNode.remove();
        const finalText = response || window.matgpt.answer(prompt);
        addMessage('assistant', finalText);
        saveLocalHistory('assistant', finalText);
        return;
      }

      const useCopilot = localStorage.getItem('matgpt_use_copilot') === '1';
      if (useCopilot && window.copilot && typeof window.copilot.answer === 'function') {
        const response = await window.copilot.answer(prompt);
        thinkingNode.remove();
        addMessage('assistant', response || window.matgpt.answer(prompt));
        saveLocalHistory('assistant', response || window.matgpt.answer(prompt));
        return;
      }

      const fallback = window.matgpt.answer(prompt);
      thinkingNode.remove();
      addMessage('assistant', fallback);
      saveLocalHistory('assistant', fallback);
    } catch (err) {
      console.warn('MatGPT remote call failed; using fallback', err);
      thinkingNode.remove();
      const fallback = window.matgpt.answer(prompt);
      addMessage('assistant', fallback);
      saveLocalHistory('assistant', fallback);
    }
  });

  btnNew.addEventListener('click', ()=>{ clearLocalHistory(); });
  btnStop.addEventListener('click', ()=>{ alert('No streaming to stop in local mode.'); });
  btnChats.addEventListener('click', ()=>{
    const existing = window.matgpt && typeof window.matgpt.getApiKey === 'function' ? window.matgpt.getApiKey() : null;
    let msg = 'Paste your OpenAI API key to enable real AI. Leave blank to disable.';
    if (existing) msg = 'An API key is already saved. Paste a new key to replace it, or leave blank to remove it.';
    const key = prompt(msg, existing || '');
    if (key === null) return;
    if (!key) {
      if (window.matgpt && typeof window.matgpt.clearApiKey === 'function') window.matgpt.clearApiKey();
      alert('OpenAI key removed. MatGPT will use local responses.');
      return;
    }
    const ok = window.matgpt && typeof window.matgpt.setApiKey === 'function' ? window.matgpt.setApiKey(key.trim()) : false;
    if (ok) alert('OpenAI key saved locally. Real AI flow enabled.'); else alert('Failed to save key in this browser.');
  });

  btnCopilot.addEventListener('click', ()=>{
    const cur = localStorage.getItem('matgpt_use_copilot') === '1';
    const next = !cur;
    setCopilotActive(next);
    if (next){
      alert('Copilot bridge enabled (only used if a bridge exists).');
    } else {
      alert('Copilot bridge disabled.');
    }
  });

  function addIntro(){
    const intro = document.createElement('div');
    intro.style.cssText='padding:10px 12px;border-radius:10px;background:rgba(255,255,255,0.01);border:1px solid rgba(255,255,255,0.02);color:#dfeaff;';
    intro.textContent = 'Welcome to MatGPT. Type a question below and press Enter. If you saved an OpenAI key, MatGPT will use it before falling back to local mode.';
    chat.appendChild(intro);
  }

  // compose UI
  shell.appendChild(topbar);
  shell.appendChild(chat);
  shell.appendChild(form);
  root.appendChild(shell);

  const existing = loadLocalHistory(); if (existing.length === 0) addIntro();
}
___
