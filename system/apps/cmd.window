___
Close:{
  enabled:true,
  show:true,
  onclick:()=>{}
},
Maximalize:{
  enabled:true,
  show:true,
  onclick:()=>{}
},
Minimalize:{
  enabled:true,
  show:true,
  onclick:()=>{}
},
OnOpen:(win)=>{
  const input = win.querySelector('input');
  if (input) setTimeout(() => input.focus(), 120);
},
Style:{
  blur:"100px",
  title:"CMD",
  titlebar:{
    color:"rgba(12,14,20,0.54)"
  },
  maincolor:"rgba(10,12,14,0.6)"
},
render:(root)=>{
  try{
    root.style.display = 'flex';
    root.style.flexDirection = 'column';
    root.style.height = '100%';
    root.style.boxSizing = 'border-box';
    root.style.minHeight = '0';
  }catch(e){}

  function loadIcon(path, fallback){
    const img = document.createElement('img');
    img.src = path;
    img.onerror = () => { if (fallback) img.src = fallback; };
    return img;
  }

  const shell = document.createElement('div');
  shell.style.cssText = 'position:relative;width:100%;height:100%;display:flex;flex-direction:column;gap:8px;box-sizing:border-box;min-height:0;color:#cfe8ff;font-family:Menlo, Monaco, monospace;';

  const bg = loadIcon('svg/apps/cmd.svg', 'png/icon.png');
  bg.style.position = 'absolute';
  bg.style.right = '8px';
  bg.style.top = '8px';
  bg.style.width = '160px';
  bg.style.height = '160px';
  bg.style.opacity = '0.9';
  bg.style.filter = 'blur(100px)';
  bg.style.pointerEvents = 'none';
  bg.style.userSelect = 'none';
  bg.style.zIndex = '0';
  shell.appendChild(bg);

  const term = document.createElement('div');
  term.style.cssText = 'flex:1;min-height:0;display:flex;flex-direction:column;gap:6px;overflow:hidden;padding:12px;border-radius:8px;border:1px solid rgba(255,255,255,0.03);background:linear-gradient(180deg, rgba(8,10,12,0.88), rgba(6,8,10,0.96));box-shadow:inset 0 0 40px rgba(0,0,0,0.6);z-index:1;';

  const info = document.createElement('div');
  info.textContent = 'CMD — type /help for commands';
  info.style.cssText = 'font-size:12px;color:rgba(200,230,255,0.8);';
  term.appendChild(info);

  const output = document.createElement('div');
  output.classList.add('matgpt-cmd-output');
  output.style.cssText = 'flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;scrollbar-gutter:stable both-edges;-webkit-overflow-scrolling:touch;font-size:13px;line-height:1.4;white-space:pre-wrap;padding-right:12px;position:relative;z-index:2;';
  output.tabIndex = 0;
  term.appendChild(output);

  const form = document.createElement('form');
  form.style.cssText = 'display:flex;gap:8px;align-items:center;margin-top:6px;flex:none;z-index:2;';

  const promptLabel = document.createElement('div');
  promptLabel.textContent = '>';
  promptLabel.style.cssText = 'font-weight:700;color:#9fd6ff;min-width:18px;';

  const input = document.createElement('input');
  input.type = 'text';
  input.placeholder = 'Type a command';
  input.autocomplete = 'off';
  input.style.cssText = 'flex:1;min-width:0;height:36px;padding:6px 10px;border-radius:6px;border:1px solid rgba(255,255,255,0.04);background:rgba(255,255,255,0.01);color:#fff;font-size:13px;outline:none;';

  const submit = document.createElement('button');
  submit.type = 'submit';
  submit.textContent = 'Run';
  submit.style.cssText = 'height:36px;padding:0 12px;border-radius:6px;border:none;background:linear-gradient(180deg,rgba(80,120,255,0.12),rgba(60,90,200,0.08));color:#dff6ff;cursor:pointer;flex:none;';

  form.appendChild(promptLabel); form.appendChild(input); form.appendChild(submit);

  const FS_KEY = 'cmd_fs_v1';
  function loadFs(){ try{ const raw = localStorage.getItem(FS_KEY); if (!raw) return {}; const data = JSON.parse(raw); return typeof data === 'object' && data ? data : {}; }catch(e){ return {}; } }
  function saveFs(fs){ try{ localStorage.setItem(FS_KEY, JSON.stringify(fs)); }catch(e){} }
  function normalizePath(p){ if (!p) return '/'; p = String(p); if (!p.startsWith('/')) p = '/' + p; return p.replace(/\\/g, '/').replace(/\\\\+/g, '/'); }
  function writeFile(path, data){ const fs = loadFs(); path = normalizePath(path); fs[path] = { type:'file', content:data }; saveFs(fs); }
  function deletePath(path){ const fs = loadFs(); path = normalizePath(path); if (fs[path]){ delete fs[path]; saveFs(fs); return true; } return false; }
  function readFile(path){ const fs = loadFs(); path = normalizePath(path); const node = fs[path]; if (!node) return null; if (node.type === 'file') return node.content; return null; }

  const WINDOW_KEY = 'cmd_windows_v1';
  function loadWindows(){ try{ return JSON.parse(localStorage.getItem(WINDOW_KEY) || '[]'); }catch(e){ return []; } }
  function saveWindows(list){ try{ localStorage.setItem(WINDOW_KEY, JSON.stringify(list)); }catch(e){} }
  function openWindow(filepath){ const list = loadWindows(); const id = Date.now(); list.push({ id, path: filepath }); saveWindows(list); return id; }
  function closeWindow(id){ let list = loadWindows(); const n = list.filter(w => w.id !== id); saveWindows(n); return list.length !== n.length; }

  if (!document.getElementById('matgpt-cmd-scroll-style')){
    const ss = document.createElement('style');
    ss.id = 'matgpt-cmd-scroll-style';
    ss.textContent = `
      .matgpt-cmd-output { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.12) transparent; }
      .matgpt-cmd-output::-webkit-scrollbar { width: 10px; }
      .matgpt-cmd-output::-webkit-scrollbar-track { background: transparent; }
      .matgpt-cmd-output::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.06); border-radius: 8px; border: 2px solid transparent; background-clip: padding-box; }
      .matgpt-cmd-output:hover::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); }
    `;
    document.head.appendChild(ss);
  }

  function appendOut(lines){
    if (!lines) return;
    const atBottom = (output.scrollHeight - output.clientHeight - output.scrollTop) < 48;
    const t = typeof lines === 'string' ? lines : Array.isArray(lines) ? lines.join('\n') : String(lines);
    const node = document.createElement('div');
    node.textContent = t;
    node.style.cssText = 'padding:6px 8px;border-radius:6px;background:rgba(255,255,255,0.01);margin-bottom:6px;color:#d9f2ff;font-size:13px;';
    output.appendChild(node);
    if (atBottom) requestAnimationFrame(()=>{ output.scrollTop = output.scrollHeight; });
  }

  function runCmd(raw){ if (!raw) return; const parts = raw.trim().split(/\s+/); const cmd = parts[0]; const rest = raw.slice(cmd.length).trim();

    if (cmd === '/help' || cmd === '/h'){ appendOut(['Commands:','/create <filepath> <data>   - create a file','/delete <filepath>          - delete a file','/edit <filepath> <data>     - overwrite a file','/read <filepath>            - read file content','/open <filepath>            - open a window (returns window id)','/close <windowid>           - close a window by id','/ls                         - list files','/clear                      - clear output','/help                       - show this help']); return; }

    if (cmd === '/create'){ const m = rest.match(/^([^\s]+)\s+([\s\S]+)$/); if (!m){ appendOut('Usage: /create <filepath> <data>'); return; } const path = m[1]; const data = m[2]; if (readFile(path) !== null){ appendOut('Error: file exists'); return; } writeFile(path, data); appendOut(`Created ${path}`); return; }

    if (cmd === '/delete'){ const m = rest.match(/^([^\s]+)$/); if (!m){ appendOut('Usage: /delete <filepath>'); return; } const path = m[1]; const ok = deletePath(path); appendOut(ok ? `Deleted ${path}` : `Not found: ${path}`); return; }

    if (cmd === '/edit'){ const m = rest.match(/^([^\s]+)\s+([\s\S]+)$/); if (!m){ appendOut('Usage: /edit <filepath> <data>'); return; } const path = m[1]; const data = m[2]; if (readFile(path) === null){ appendOut('Error: file does not exist'); return; } writeFile(path, data); appendOut(`Edited ${path}`); return; }

    if (cmd === '/read'){ const m = rest.match(/^([^\s]+)$/); if (!m){ appendOut('Usage: /read <filepath>'); return; } const path = m[1]; const data = readFile(path); if (data === null) appendOut(`Not found: ${path}`); else appendOut(`--- ${path} ---\n${data}`); return; }

    if (cmd === '/open'){ const m = rest.match(/^([^\s]+)$/); if (!m){ appendOut('Usage: /open <filepath>'); return; } const path = m[1]; const id = openWindow(path); appendOut(`Opened ${path} as window ${id}`); return; }

    if (cmd === '/close'){ const m = rest.match(/^(\d+)$/); if (!m){ appendOut('Usage: /close <windowid>'); return; } const id = Number(m[1]); const ok = closeWindow(id); appendOut(ok ? `Closed window ${id}` : `Window not found: ${id}`); return; }

    if (cmd === '/ls'){ const fs = loadFs(); const keys = Object.keys(fs); if (keys.length === 0) appendOut('(no files)'); else appendOut(keys.join('\n')); return; }

    if (cmd === '/clear'){ output.innerHTML = ''; return; }

    appendOut('Unknown command. Type /help for a list of commands.'); }

  input.addEventListener('keydown', (e)=>{
    if (e.ctrlKey && e.key.toLowerCase() === 'l'){ e.preventDefault(); output.innerHTML = ''; }
    if (e.ctrlKey && e.key.toLowerCase() === 'c'){ e.preventDefault(); const last = output.lastElementChild; if (last) navigator.clipboard && navigator.clipboard.writeText(last.textContent || ''); }
    if (e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); form.dispatchEvent(new Event('submit', { bubbles:true, cancelable:true })); }
  });

  form.addEventListener('submit', (e)=>{ e.preventDefault(); const val = input.value.trim(); if (!val) return; appendOut('> ' + val); runCmd(val); input.value = ''; });

  output.addEventListener('wheel', (e)=>{ e.stopPropagation(); }, { passive:true });

  appendOut(['Welcome to CMD!', 'Type /help for available commands.']);
  if (readFile('/readme.txt') === null){ writeFile('/readme.txt', 'This is a sample file created by CMD. Use /read /readme.txt to view it.'); }

  shell.appendChild(term);
  shell.appendChild(form);
  root.appendChild(shell);
},
___
